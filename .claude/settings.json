{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(portageq:*)",
      "Bash(readelf:*)",
      "Bash(tar -t:*)",
      "Bash(tar -tzf:*)",
      "Bash(bsdtar -t:*)",
      "Bash(scanimage -L:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(emerge:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(run0:*)",
      "Bash(eselect:*)"
    ]
  }
}
