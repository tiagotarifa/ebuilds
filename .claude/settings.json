{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(ebuild:*)",
      "Bash(portageq:*)",
      "Bash(emerge -p:*)",
      "Bash(emerge --pretend:*)",
      "Bash(readelf:*)",
      "Bash(tar -t:*)",
      "Bash(tar -tzf:*)",
      "Bash(bsdtar -t:*)",
      "Bash(cmake:*)",
      "Bash(ninja:*)",
      "Bash(scanimage -L:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(emerge -a:*)",
      "Bash(emerge --ask:*)",
      "Bash(eselect:*)"
    ]
  }
}
