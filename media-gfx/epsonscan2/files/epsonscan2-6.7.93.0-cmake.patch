-if (DEFINED ENV{BUILD_TYPE})
+option(BUILD_GUI "Build the Qt6 graphical front-end (epsonscan2 and detectalert)" ON)
+option(BUILD_SCANSDK "Build the Epson Scan SDK library" ON)
 
