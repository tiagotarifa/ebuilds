- 	FILE* fp = fdopen(fd, "w");
 
 	memcpy(TempFile, buf, path_len+1);
- 	fclose(fp);
+ 	close(fd);
 	free(buf);
 
  	return TRUE;
@@ -1109,13 +1110,24 @@ namespace ES_CMN_FUNCS
 
 		std::string ES_GetWorkTempPath() 
 		{
-			pid_t c_pid;
-			c_pid = getpid();
+			// EPSON_WORK_PATH is shared by every user and is created with
+			// mode 0755 by whoever scans first, locking all other users out.
+			// Use a private directory per process instead.
+			static const std::string work_path = []() {
+				const char* tmpdir = getenv("TMPDIR");
+				std::string tmpl = (tmpdir && tmpdir[0] == '/') ? tmpdir : "/tmp";
+				tmpl += "/epsonscan2-XXXXXX";
+				std::vector<char> buf(tmpl.begin(), tmpl.end());
+				buf.push_back('\0');
+				if (mkdtemp(buf.data()) == nullptr) {
+					return "/tmp/epsonscan2-" + std::to_string(getuid()) + "_" + std::to_string(getpid()) + "/";
+				}
+				return std::string(buf.data()) + "/";
+			}();
 
-			std::string work_path = EPSON_WORK_PATH;
-			work_path = work_path + "_";
-			work_path = work_path + std::to_string(c_pid);
-			work_path = work_path + "/";
+			// The work folder is deleted when a scan session ends; re-create
+			// it here as private, as the callers would make it world-readable
+			mkdir(work_path.c_str(), 0700);
 
 			return work_path;
 		}
