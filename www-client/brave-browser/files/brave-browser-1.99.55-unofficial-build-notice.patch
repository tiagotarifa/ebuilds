+++ b/brave/browser/resources/settings/br/about_page.ts
@@ -43,6 +43,17 @@ const buildChromiumVersionElement = (chromiumVersion: string) => {
   return chromiumElement
 }
 
+// Gentoo: this is not one of Brave Software's builds
+const buildUnofficialBuildNotice = () => {
+  const notice = document.createElement('div')
+  notice.setAttribute('id', 'unofficial-build-notice')
+  notice.classList.add('secondary')
+  notice.textContent =
+    'Unofficial build compiled from source by the tiagotarifa Gentoo overlay.'
+
+  return notice
+}
